  "item": [
    {
      "name": "00 - Sesión",
      "item": [
        {
          "name": "GET Preparar sesión y token CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/login.php"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La página de acceso respondió correctamente\", function () {",
                  "    pm.expect(pm.response.code).to.be.below(400);",
                  "});",
                  "const token = pm.response.text().match(/name=\"token_csrf\" value=\"([a-f0-9]+)\"/i);",
                  "pm.test(\"Se encontró el token CSRF de la sesión\", function () {",
                  "    pm.expect(token, \"token_csrf en el HTML de acceso\").to.not.be.null;",
                  "});",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"token_csrf\", token[1]);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth.php",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "identifier",
                  "value": "{{usuario_login}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password_login}}",
                  "type": "text"
                },
                {
                  "key": "token_csrf",
                  "value": "{{token_csrf}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
